# AI Provider Configuration
# -------------------------
# Supported providers: "anthropic", "gemini", "ollama", "openai"
NUXT_AI_PROVIDER=ollama

# API key (required when provider is "anthropic", "gemini", or "openai")
# Anthropic: https://console.anthropic.com/
# Gemini: https://aistudio.google.com/
# OpenAI: https://platform.openai.com/api-keys
# NUXT_AI_API_KEY=

# Ollama host URL (required when provider is "ollama")
NUXT_AI_OLLAMA_HOST=http://127.0.0.1:11434

# Override the default AI model (optional)
# Anthropic default: claude-sonnet-4-20250514
# Gemini default: gemini-2.0-flash
# OpenAI default: gpt-4o
# Ollama default: llama3.2
# NUXT_AI_MODEL=qwen3.5:9b
